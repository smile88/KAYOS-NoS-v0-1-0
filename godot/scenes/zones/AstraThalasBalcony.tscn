[node name="Roster" type="Area2D" parent="World"]
position = Vector2(200, 900)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "The Duty Roster"
examine_text = "Tonight's watch, in your own hand. Ninth bell: Sorrel. Tenth: Vashti. Eleventh: the Ferrin boy, whose name you never learned to spell. Every line struck through, each in its own apologetic ink, each with the same excuse written small beside it. They are all down there dancing. You did not strike your own name through. Nobody asked you to."

[node name="Body" type="Sprite2D" parent="World/Roster"]
position = Vector2(0, -70)
texture = ExtResource("37_roster")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Roster"]
position = Vector2(0, -70)
shape = SubResource("small_shape")

[node name="ScrollRack1" type="Area2D" parent="World"]
position = Vector2(300, 900)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Scroll Rack — Recent Years"
examine_text = "The last two centuries, in the hands of eleven scribes, four of them yours. Harvest yields. Tower maintenance. A dispute about a boundary wall that ran forty years and was settled by both parties dying. Nothing in this rack has ever mattered. You have loved it more than you have loved most people."

[node name="Body" type="Sprite2D" parent="World/ScrollRack1"]
position = Vector2(0, -48)
texture = ExtResource("34_rack")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/ScrollRack1"]
position = Vector2(0, -48)
shape = SubResource("tall_shape")

[node name="ScrollRack2" type="Area2D" parent="World"]
position = Vector2(420, 900)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Scroll Rack — the Middle Ages"
examine_text = "Eight hundred years compressed into one rack, because so little happened in them. The Age of Order is not a story. It is the absence of one. Somewhere in here is the year you arrived in this city, and you could find it in a moment, and you never have."

[node name="Body" type="Sprite2D" parent="World/ScrollRack2"]
position = Vector2(0, -48)
texture = ExtResource("34_rack")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/ScrollRack2"]
position = Vector2(0, -48)
shape = SubResource("tall_shape")

[node name="ScrollRack3" type="Area2D" parent="World"]
position = Vector2(540, 900)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Scroll Rack — the Empty Shelf"
examine_text = "The rack for the years still to come, built by an optimist two thousand years ago and not yet a third full. There is room on it for another six hundred years of harvest yields. You have never once looked at this shelf and felt what you feel looking at it now."

[node name="Body" type="Sprite2D" parent="World/ScrollRack3"]
position = Vector2(0, -48)
texture = ExtResource("34_rack")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/ScrollRack3"]
position = Vector2(0, -48)
shape = SubResource("tall_shape")

[node name="Window" type="Area2D" parent="World"]
position = Vector2(900, 900)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "The Scriptorium Window"
examine_text = "The festival, at a distance and through old glass, which is the way you have taken in most things. Gold light lies across the desks in long bars and does not warm them. From here the crowd makes no sound at all. You could watch the whole of it from this chair and never be in any of it. You have."

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Window"]
position = Vector2(0, -40)
shape = SubResource("desk_shape")

[node name="Cabinet" type="Area2D" parent="World"]
position = Vector2(1140, 900)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "The Locked Cabinet"
examine_text = "Indigo lacquer, and a keyhole you have the key to. This is where the letter lived for three hundred years — through four Grand Archmages, two plagues and a coronation, while you told yourself that the night she meant was not this one and had not come yet. You took it out this evening. You are aware that you took it out this evening. You have not let yourself look at why."

[node name="Body" type="Sprite2D" parent="World/Cabinet"]
position = Vector2(0, -48)
texture = ExtResource("36_cabinet")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Cabinet"]
position = Vector2(0, -48)
shape = SubResource("tall_shape")

[node name="Desk" type="Area2D" parent="World"]
position = Vector2(400, 1080)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Your Desk"
examine_text = "Sixty years of the same chair, worn to the shape of you. Tonight's page is begun and abandoned: 'The two-thousandth Luminarae. The city is —' and there the ink stops, because you could not think of the word and went upstairs instead. The nib has dried. It will not be the sentence you finish tonight."

[node name="Body" type="Sprite2D" parent="World/Desk"]
position = Vector2(0, -32)
texture = ExtResource("32_desk")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Desk"]
position = Vector2(0, -32)
shape = SubResource("desk_shape")

[node name="Tea" type="Area2D" parent="World"]
position = Vector2(320, 1120)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "A Cold Cup"
examine_text = "Long cold, with a skin on it. You made it at the seventh bell, meaning to drink it, and then the light through the window went the colour it goes and you went up to look at the sky instead. It has been a very long time since anything made you forget a cup of tea."

[node name="Body" type="Sprite2D" parent="World/Tea"]
position = Vector2(0, -8)
texture = ExtResource("33_tea")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Tea"]
position = Vector2(0, -8)
shape = SubResource("small_shape")

[node name="SealKit" type="Area2D" parent="World"]
position = Vector2(520, 1140)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Wax and Matrix"
examine_text = "Your sealing wax is archive-grey, as every scribe's is. But there is one stick of indigo in the bottom of the drawer, and you did not buy it, and it has sat there three hundred years going slowly hard. The matrix that matches it is not here. She kept that. Of course she kept that."

[node name="Body" type="Sprite2D" parent="World/SealKit"]
position = Vector2(0, -12)
texture = ExtResource("39_seal")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/SealKit"]
position = Vector2(0, -12)
shape = SubResource("small_shape")

[node name="VolumeOne" type="Area2D" parent="World"]
position = Vector2(700, 1000)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Volume the First"
examine_text = "The oldest book in the room, in a hand two thousand years dead, opening the Age of Order with a sentence every apprentice copies out and none of them think about: 'Let it be recorded that on this day the Song was made steady, and will not fail, and there is therefore nothing further to record.' The rest of the volume is blank. He was so nearly right."

[node name="Body" type="Sprite2D" parent="World/VolumeOne"]
position = Vector2(0, -16)
texture = ExtResource("38_vol1")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/VolumeOne"]
position = Vector2(0, -16)
shape = SubResource("small_shape")

[node name="Chest" type="Area2D" parent="World"]
position = Vector2(880, 1180)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Document Chest"
examine_text = "Deeds, mostly, and the tedious immortal paperwork of a city that expects to go on forever: water rights, tower levies, a folder of complaints about the bells. Underneath it all, a survey of the Songlines, drawn when someone still thought they were worth surveying. It is nine hundred years old. It is the newest one there is."

[node name="Body" type="Sprite2D" parent="World/Chest"]
position = Vector2(0, -20)
texture = ExtResource("35_chest")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Chest"]
position = Vector2(0, -20)
shape = SubResource("small_shape")

[node name="ApprenticeDesk" type="Area2D" parent="World"]
position = Vector2(1050, 1280)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "The Apprentice's Desk"
examine_text = "Sorrel's. Neat, which yours never was at her age. A half-copied inventory, a pressed flower doing duty as a bookmark, and a note in her round hand: 'Back before the ninth — don't tell.' She is nineteen. She has gone to watch the sky catch fire with a boy from the granary. You would not have told."

[node name="Body" type="Sprite2D" parent="World/ApprenticeDesk"]
position = Vector2(0, -32)
texture = ExtResource("32_desk")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/ApprenticeDesk"]
position = Vector2(0, -32)
shape = SubResource("desk_shape")

[node name="DeskLampObj" type="Area2D" parent="World"]
position = Vector2(640, 1300)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "The Reading Lamp"
examine_text = "You have read by this lamp for sixty years and never once wondered where the light in it comes from, any more than you wonder where the floor comes from. It is the Song. Everything here is the Song. Put your hand near the glass: that faint pressure against your palm is the hum of the world holding itself together, and it has never, in two thousand years, so much as stuttered."

