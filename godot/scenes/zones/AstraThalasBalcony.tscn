[node name="FestivalGoer" parent="World" instance=ExtResource("3_npc")]
unique_name_in_owner = true
position = Vector2(820, 440)
character_data = ExtResource("4_fg")

[node name="Lamplighter" parent="World" instance=ExtResource("3_npc")]
modulate = Color(0.82, 0.86, 0.95, 1)
position = Vector2(140, 430)
script = ExtResource("40_wanderer")
character_data = ExtResource("4_fg")
display_name = "The Lamplighter"
portrait_id = "PO-014"
examine_text = "\"Sixty-first Luminarae I've worked, and there's nothing to light. There's never anything to light. My father held the office, and his mother before him, and not one of us has ever struck a flame in this city.\" He turns his unlit taper over in his hands. \"Tonight of all nights, scribe, I'd like there to be something to light.\""
roam_rect = Rect2(60, 380, 200, 130)

[node name="Reveller" parent="World" instance=ExtResource("3_npc")]
modulate = Color(1, 0.86, 0.72, 1)
position = Vector2(380, 530)
script = ExtResource("40_wanderer")
character_data = ExtResource("4_fg")
display_name = "A Reveller, Well On"
portrait_id = "PO-014"
examine_text = "\"Two thousand years!\" He holds up two fingers, then looks at them, unconvinced. \"Do you know what that is, scribe? That's — that's a lot of years. That's all of them. That's every year there's ever been.\" He is going to be very unwell tomorrow, and that is the worst thing that is going to happen to him tomorrow."
roam_rect = Rect2(300, 470, 190, 150)
speed = 14.0

[node name="Mother" parent="World" instance=ExtResource("3_npc")]
modulate = Color(0.9, 0.78, 0.86, 1)
position = Vector2(560, 665)
script = ExtResource("40_wanderer")
character_data = ExtResource("4_fg")
display_name = "A Woman, Looking"
portrait_id = "PO-014"
examine_text = "\"Have you seen a boy? So high. Gold mask, the nine rays, he cut it himself and he won't be parted from it.\" She is not frightened yet — it is a festival, and children run. \"He was at the rail a moment ago. He wanted to see the Tower.\""
roam_rect = Rect2(470, 600, 220, 100)
speed = 30.0
pause_min = 0.4
pause_max = 1.6

[node name="Couple" parent="World" instance=ExtResource("3_npc")]
modulate = Color(0.78, 0.9, 0.88, 1)
position = Vector2(700, 385)
script = ExtResource("40_wanderer")
character_data = ExtResource("4_fg")
display_name = "Two, Leaning"
portrait_id = "PO-014"
examine_text = "\"We came up for the view and stayed for the quiet.\" She does not look away from the city while she says it. \"Don't tell them it's quiet up here. They'll all come.\" Beside her he says nothing at all, and has the face of a man who would stand on this balcony for the rest of his life."
roam_rect = Rect2(660, 356, 120, 60)
speed = 8.0
pause_min = 4.0
pause_max = 9.0

[node name="Priest" parent="World" instance=ExtResource("3_npc")]
modulate = Color(1, 0.98, 0.86, 1)
position = Vector2(960, 570)
script = ExtResource("40_wanderer")
character_data = ExtResource("4_fg")
display_name = "A Solari Celebrant"
portrait_id = "PO-014"
examine_text = "\"The Song is eternal.\" She says it the way you would say the sky is blue — no fervour in it, none needed. \"Say it with me, scribe, it steadies a person. The Song is eternal, and was here before us, and will be here after.\" She smiles at your face. \"You've gone grey. Sit down. It's a festival.\""
roam_rect = Rect2(880, 510, 190, 140)

[node name="Functionary" parent="World" instance=ExtResource("3_npc")]
modulate = Color(0.8, 0.82, 1, 1)
position = Vector2(1120, 470)
script = ExtResource("40_wanderer")
character_data = ExtResource("4_fg")
display_name = "A Tower Functionary"
portrait_id = "PO-014"
examine_text = "\"He's been up there since the sixth bell.\" He means Sulvaine; up here tonight everyone means Sulvaine. \"Hasn't eaten. Sent the attendants out.\" He laughs, and it does not come out right. \"They're saying he's nervous. Archmages aren't nervous. It's a ceremony. We've done it two thousand times.\""
roam_rect = Rect2(1040, 410, 200, 130)
speed = 26.0

[node name="Warden" parent="World" instance=ExtResource("3_npc")]
modulate = Color(0.72, 0.8, 0.78, 1)
position = Vector2(1190, 630)
script = ExtResource("40_wanderer")
character_data = ExtResource("4_fg")
display_name = "A Bored Warden"
portrait_id = "PO-014"
examine_text = "\"Same duty every Luminarae: stop the balcony falling into the street.\" He does not look at the balcony. \"Two thousand years, and it has never once tried. I'll be here till the tenth bell and then I'll go and find my wife and she'll be drunk.\" He nods at the crowd, comfortable, incurious, entirely safe."
roam_rect = Rect2(1120, 570, 110, 120)
speed = 10.0

[node name="Banner" type="Area2D" parent="World"]
position = Vector2(240, 392)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Festival Banner"
examine_text = "Gold thread on white silk: THE TWO-THOUSANDTH LUMINARAE. Beneath the sun-sigil, in smaller stitching: 'May the Song hold.' It has held for two thousand years."
flag_on_interact = "COLDOPEN_SAW_BANNER"

[node name="Body" type="Sprite2D" parent="World/Banner"]
position = Vector2(0, -32)
texture = ExtResource("15_banner")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Banner"]
position = Vector2(0, -28)
shape = SubResource("banner_shape")

[node name="Telescope" type="Area2D" parent="World"]
position = Vector2(1060, 392)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Festival Telescope"
examine_text = "Set out for the crowds, aimed at the Tower of Celestial Harmony. Through the lens: the whole spire alight, and a tiny silhouette upon it — the Grand Archmage, arms rising with the apex of the ceremony. For a heartbeat you think you see the lights below the Tower flicker. An old man's eyes. Surely."
flag_on_interact = "COLDOPEN_SAW_TELESCOPE"

[node name="Body" type="Sprite2D" parent="World/Telescope"]
position = Vector2(0, -22)
texture = ExtResource("16_scope")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Telescope"]
position = Vector2(0, -20)
shape = SubResource("scope_shape")

[node name="Satchel" type="Area2D" parent="World"]
position = Vector2(560, 540)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Your Satchel"
examine_text = "Ink, nibs, blotting sand — and beneath them, wrapped in oilcloth, a letter. The hand that wrote your name on it was precise, unhurried, three hundred years gone. The indigo wax seal — a void, held — is unbroken. 'You will know the night,' she said. You have carried it so long you had almost stopped believing there would be one."
flag_on_interact = "COLDOPEN_SAW_LETTER"

[node name="Body" type="Sprite2D" parent="World/Satchel"]
position = Vector2(0, -14)
texture = ExtResource("17_letter")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Satchel"]
position = Vector2(0, -12)
shape = SubResource("small_shape")

[node name="StairDown" type="Area2D" parent="World"]
unique_name_in_owner = true
position = Vector2(120, 664)
collision_layer = 2
collision_mask = 0
script = ExtResource("7_stair")
display_name = "The Stair Down"
target_room = "scriptorium"

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/StairDown"]
position = Vector2(0, -24)
shape = SubResource("stair_shape")

[node name="StarLamp" type="Area2D" parent="World"]
position = Vector2(60, 392)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Star-Lamp"
examine_text = "No flame in it. There has never been a flame in it — the Solari hang these and the Song fills them, the way water fills a cup you did not know was empty. Every child in Astra'Thalas learns the trick of cupping their hands round one to feel the hum. You do it now, an old man alone at the rail. It hums."

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/StarLamp"]
position = Vector2(0, -24)
shape = SubResource("lamp_shape")

[node name="StarLamp2" type="Area2D" parent="World"]
position = Vector2(1230, 392)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Star-Lamp"
examine_text = "The twin of the one at the far end, and of nine thousand others down in the districts, and of the great ones ringing the Tower. Nobody lights them. Nobody has ever lit them. That is not a thing anyone in this city has ever had to think about, and you are thinking about it now."

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/StarLamp2"]
position = Vector2(0, -24)
shape = SubResource("lamp_shape")

[node name="SunMask" type="Area2D" parent="World"]
position = Vector2(320, 640)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "A Child's Sun-Mask"
examine_text = "Gold paper on a willow frame, the sun's nine rays cut out by hand. Dropped in the rush to see the Tower, and already trodden on once. Someone will cry about this tomorrow. You catch yourself on the word — tomorrow — and cannot say why it has gone cold in your mouth."

[node name="Body" type="Sprite2D" parent="World/SunMask"]
position = Vector2(0, -8)
texture = ExtResource("23_mask")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/SunMask"]
position = Vector2(0, -8)
shape = SubResource("small_shape")

[node name="Ledger" type="Area2D" parent="World"]
position = Vector2(470, 620)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Your Ledger"
examine_text = "Sixty years of entries in your own narrowing hand. Weather. Deaths. The price of ink. The chronicle of a city that has never needed chronicling, because nothing here has ever changed. You have long thought your life's work one very long sentence with no verb in it. She promised you a verb."

[node name="Body" type="Sprite2D" parent="World/Ledger"]
position = Vector2(0, -10)
texture = ExtResource("26_ledger")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Ledger"]
position = Vector2(0, -10)
shape = SubResource("small_shape")

[node name="SunMosaic" type="Area2D" parent="World"]
position = Vector2(640, 450)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Sun-Sigil Mosaic"
examine_text = "Gold tesserae, worn pale by two thousand years of feet. The Solari set these into every high place in the city so the Song would always have somewhere to land. You have never been certain whether that is theology or engineering. You have never been certain the Solari know either."

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/SunMosaic"]
shape = SubResource("mosaic_shape")

[node name="Broadsheet" type="Area2D" parent="World"]
position = Vector2(790, 620)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Order of Ceremony"
examine_text = "THE ORDER OF THE TWO-THOUSANDTH LUMINARAE, struck in gold on cheap pulp. The apex is timed to the ninth bell: the Grand Archmage Sulvaine will draw the Song up through the Tower and return it to the city sevenfold. At the foot, in the smallest type the press could set: by the grace of the Song, which is eternal."

[node name="Body" type="Sprite2D" parent="World/Broadsheet"]
position = Vector2(0, -8)
texture = ExtResource("25_sheet")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Broadsheet"]
position = Vector2(0, -8)
shape = SubResource("small_shape")

[node name="RailEdge" type="Area2D" parent="World"]
position = Vector2(640, 340)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "The Balustrade"
examine_text = "Marble, worn smooth and faintly hollow at exactly the height of a man's forearms. Two thousand years of people leaning here to look at their own city. Sixty of those years are yours. Below, nine thousand move like one animal breathing, and under the streets the Songlines run faint and gold, the way veins run under skin. Nobody looks at them. Nobody has ever had to."

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/RailEdge"]
shape = SubResource("rail_shape")

[node name="RailCarving" type="Area2D" parent="World"]
position = Vector2(900, 340)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Initials, Cut in the Rail"
examine_text = "Two sets of initials cut into the underside of the rail, where the wardens would not think to look. The cuts are old. You do not know who they were, and there is no one left to ask. That is the ordinary fate of very nearly everyone. It has never frightened you before tonight."

[node name="Body" type="Sprite2D" parent="World/RailCarving"]
position = Vector2(0, -6)
texture = ExtResource("28_carving")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/RailCarving"]
position = Vector2(0, -6)
shape = SubResource("small_shape")

[node name="WineCups" type="Area2D" parent="World"]
position = Vector2(1150, 650)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Two Cups, Left Behind"
examine_text = "Both empty, set side by side on the parapet. Someone brought a friend up here to look at the city and did not stay long. The rims are still sticky — honey, clove, and something floral the Solari have never agreed on a name for."

[node name="Body" type="Sprite2D" parent="World/WineCups"]
position = Vector2(0, -6)
texture = ExtResource("24_cups")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/WineCups"]
position = Vector2(0, -6)
shape = SubResource("small_shape")

