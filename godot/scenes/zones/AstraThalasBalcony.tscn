[node name="Telescope" type="Area2D" parent="World"]
position = Vector2(520, 216)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Festival Telescope"
examine_text = "Set out for the crowds, aimed at the Tower of Celestial Harmony. Through the lens: the whole spire alight, and a tiny silhouette upon it — the Grand Archmage, arms rising with the apex of the ceremony. For a heartbeat you think you see the lights below the Tower flicker. An old man's eyes. Surely."
flag_on_interact = "COLDOPEN_SAW_TELESCOPE"

[node name="Body" type="Sprite2D" parent="World/Telescope"]
position = Vector2(0, -22)
texture = ExtResource("12_scope")

[node name="CollisionShape2D" type="CollisionShape2D" parent="World/Telescope"]
position = Vector2(0, -20)
shape = SubResource("scope_shape")

[node name="Satchel" type="Area2D" parent="World"]
position = Vector2(276, 172)
collision_layer = 2
collision_mask = 0
script = ExtResource("6_interactable")
display_name = "Your Satchel"
examine_text = "Ink, nibs, the ledger — and beneath them, wrapped in oilcloth, a letter. The hand that wrote your name on it was precise, unhurried, three hundred years gone. The indigo wax seal — a void, held — is unbroken. 'You will know the night,' she said. You have carried it so long you had almost stopped believing there would be one."
flag_on_interact = "COLDOPEN_SAW_LETTER"

