; Engine configuration file.
; KAYOS: The Night of Silence — Godot 4.7
; Settings per GDD §13: 640x360 native, integer scaling, Nearest filter, Compatibility renderer.

config_version=5

[application]

config/name="KAYOS: The Night of Silence"
config/description="A narrative-first 2D top-down RPG. Elorin builds the Nullstone; Grakkar activates it 300 years later. The Legacy System writes Part One choices into Part Two."
run/main_scene="res://scenes/zones/StarfallAcademy.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/GameState.gd"
DialogueManager="*res://autoload/DialogueManager.gd"
SceneManager="*res://autoload/SceneManager.gd"
AudioManager="*res://autoload/AudioManager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://ui/default_theme.tres"

